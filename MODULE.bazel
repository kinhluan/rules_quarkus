"""
Bazel rules for building Quarkus applications with build-time augmentation.

Uses the official QuarkusBootstrap API for full Quarkus feature support.
"""

module(
    name = "rules_quarkus",
    version = "0.3.0",
    compatibility_level = 1,
    bazel_compatibility = [">=7.0.0"],
)

# Bazel dependencies
bazel_dep(name = "rules_java", version = "9.9.0")
bazel_dep(name = "rules_jvm_external", version = "6.6")

# Test-only: JUnit runner for the augmentor tests (//tools/src/test:tests)
bazel_dep(name = "contrib_rules_jvm", version = "0.27.0", dev_dependency = True)

# Maven dependencies for Quarkus
maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")

# ===========================================
# Quarkus version line: "3" (3.x LTS) or "4" (4.x)
# ===========================================
# CI builds every line in a matrix by rewriting this assignment
# (see .github/workflows/ci.yml). To try a line locally, edit it here.
QUARKUS_LINE = "3"

# Versions validated together, per line. Explicit pins win over transitive
# versions (version_conflict_policy = "pinned"), so they MUST match the Quarkus
# BOM of the line: e.g. pinning Vert.x 4 under Quarkus 4 (Vert.x 5) breaks it.
# None = not available for that line (the artifacts are left out).
_PROFILES = {
    "3": {
        "quarkus": "3.40.1.2",
        "vertx": "4.5.35",
        "gizmo": "1.10.1",
        "jandex": "3.6.0",
        "asm": "9.10.1",
        "cdi_api": "jakarta.enterprise:jakarta.enterprise.cdi-api:4.1.0",
        "cdi_api_label": "@maven//:jakarta_enterprise_jakarta_enterprise_cdi_api",
        "excluded": [],
        "unleash": "1.15.0",
        "langchain4j": "1.13.3",
        "tika": "2.3.2",
    },
    "4": {
        "quarkus": "4.0.0",
        "vertx": "5.2.3",
        "gizmo": "1.10.1",
        "jandex": "3.6.1",
        "asm": "9.11.1",
        # CDI 5 moved to jakarta.cdi:*. The old jakarta.enterprise coordinates are
        # relocation POMs whose parent relocates to a non-existent
        # jakarta.cdi:jakarta.cdi.parent, which Coursier fails on - so exclude them.
        "cdi_api": "jakarta.cdi:jakarta.cdi-api:5.0.0",
        "cdi_api_label": "@maven//:jakarta_cdi_jakarta_cdi_api",
        "excluded": [
            "jakarta.enterprise:jakarta.enterprise.cdi-api",
            "jakarta.enterprise:jakarta.enterprise.lang-model",
        ],
        # Latest quarkus-unleash (1.15.0) is built against Quarkus 3.38.
        "unleash": None,
        "langchain4j": "2.0.0.Beta4",
        "tika": "4.0.0",
    },
}

_V = _PROFILES[QUARKUS_LINE]

QUARKUS_VERSION = _V["quarkus"]

VERTX_VERSION = _V["vertx"]

UNLEASH_VERSION = _V["unleash"]

LANGCHAIN4J_VERSION = _V["langchain4j"]

TIKA_VERSION = _V["tika"]

JUNIT_VERSION = "6.1.3"

_UNLEASH_ARTIFACTS = [
    "io.quarkiverse.unleash:quarkus-unleash:%s" % UNLEASH_VERSION,
] if UNLEASH_VERSION else []

maven.install(
    name = "maven",
    artifacts = [
        # ===========================================
        # Quarkus Core
        # ===========================================
        "io.quarkus:quarkus-core:%s" % QUARKUS_VERSION,
        "io.quarkus:quarkus-core-deployment:%s" % QUARKUS_VERSION,

        # ===========================================
        # Quarkus ArC (CDI)
        # ===========================================
        "io.quarkus:quarkus-arc:%s" % QUARKUS_VERSION,
        "io.quarkus:quarkus-arc-deployment:%s" % QUARKUS_VERSION,
        "io.quarkus.arc:arc:%s" % QUARKUS_VERSION,
        "io.quarkus.arc:arc-processor:%s" % QUARKUS_VERSION,

        # ===========================================
        # Quarkus Bootstrap
        # ===========================================
        "io.quarkus:quarkus-bootstrap-core:%s" % QUARKUS_VERSION,
        "io.quarkus:quarkus-bootstrap-app-model:%s" % QUARKUS_VERSION,
        "io.quarkus:quarkus-bootstrap-runner:%s" % QUARKUS_VERSION,

        # ===========================================
        # Quarkus Builder
        # ===========================================
        "io.quarkus:quarkus-builder:%s" % QUARKUS_VERSION,

        # ===========================================
        # Quarkus REST (formerly RESTEasy Reactive)
        # ===========================================
        "io.quarkus:quarkus-rest:%s" % QUARKUS_VERSION,
        "io.quarkus:quarkus-rest-jackson:%s" % QUARKUS_VERSION,
        "io.quarkus:quarkus-vertx-http:%s" % QUARKUS_VERSION,

        # ===========================================
        # Quarkus Mutiny (Reactive)
        # ===========================================
        "io.quarkus:quarkus-mutiny:%s" % QUARKUS_VERSION,

        # ===========================================
        # Tier 2: Reactive Database Clients
        # ===========================================
        "io.quarkus:quarkus-reactive-oracle-client:%s" % QUARKUS_VERSION,
        "io.quarkus:quarkus-reactive-mysql-client:%s" % QUARKUS_VERSION,
        "io.quarkus:quarkus-redis-client:%s" % QUARKUS_VERSION,

        # ===========================================
        # Tier 3: Messaging
        # ===========================================
        "io.quarkus:quarkus-messaging-rabbitmq:%s" % QUARKUS_VERSION,
        "io.quarkus:quarkus-messaging-kafka:%s" % QUARKUS_VERSION,
        "io.quarkus:quarkus-grpc:%s" % QUARKUS_VERSION,

        # ===========================================
        # Tier 4: Observability
        # ===========================================
        "io.quarkus:quarkus-micrometer-registry-prometheus:%s" % QUARKUS_VERSION,
        "io.quarkus:quarkus-smallrye-health:%s" % QUARKUS_VERSION,

        # ===========================================
        # Tier 5: Quarkiverse Extensions
        # ===========================================
        # LangChain4j (AI/LLM)
        "io.quarkiverse.langchain4j:quarkus-langchain4j-core:%s" % LANGCHAIN4J_VERSION,
        "io.quarkiverse.langchain4j:quarkus-langchain4j-openai:%s" % LANGCHAIN4J_VERSION,
        "io.quarkiverse.langchain4j:quarkus-langchain4j-ollama:%s" % LANGCHAIN4J_VERSION,

        # Tika (content analysis)
        "io.quarkiverse.tika:quarkus-tika:%s" % TIKA_VERSION,

        # Quarkus artifacts pulled only transitively by Quarkiverse extensions (tika,
        # langchain4j) that were built against an older Quarkus; pinned so they match core.
        "io.quarkus:quarkus-apache-httpclient:%s" % QUARKUS_VERSION,
        "io.quarkus:quarkus-apache-httpclient-deployment:%s" % QUARKUS_VERSION,
        "io.quarkus:quarkus-awt:%s" % QUARKUS_VERSION,
        "io.quarkus:quarkus-awt-deployment:%s" % QUARKUS_VERSION,
        "io.quarkus:quarkus-cache-deployment-spi:%s" % QUARKUS_VERSION,
        "io.quarkus:quarkus-qute:%s" % QUARKUS_VERSION,
        "io.quarkus:quarkus-qute-deployment:%s" % QUARKUS_VERSION,

        # ===========================================
        # Gizmo for bytecode generation
        # ===========================================
        "io.quarkus.gizmo:gizmo:%s" % _V["gizmo"],

        # ===========================================
        # Jandex for bytecode indexing
        # ===========================================
        "io.smallrye:jandex:%s" % _V["jandex"],

        # ===========================================
        # Vert.x
        # ===========================================
        "io.vertx:vertx-core:%s" % VERTX_VERSION,
        "io.vertx:vertx-web:%s" % VERTX_VERSION,

        # ===========================================
        # Jakarta APIs
        # ===========================================
        _V["cdi_api"],
        "jakarta.inject:jakarta.inject-api:2.0.1",
        "jakarta.annotation:jakarta.annotation-api:3.0.0",
        "jakarta.ws.rs:jakarta.ws.rs-api:4.0.0",

        # ===========================================
        # JBoss Logging
        # ===========================================
        "org.jboss.logging:jboss-logging:3.6.3.Final",
        "org.jboss.logmanager:jboss-logmanager:3.2.2.Final",

        # ===========================================
        # ASM for bytecode manipulation
        # ===========================================
        "org.ow2.asm:asm:%s" % _V["asm"],
        "org.ow2.asm:asm-commons:%s" % _V["asm"],

        # ===========================================
        # Test-only (//tools/src/test:tests)
        # ===========================================
        "org.junit.jupiter:junit-jupiter-api:%s" % JUNIT_VERSION,
        "org.junit.jupiter:junit-jupiter-engine:%s" % JUNIT_VERSION,
        "org.junit.jupiter:junit-jupiter-params:%s" % JUNIT_VERSION,
        "org.junit.platform:junit-platform-launcher:%s" % JUNIT_VERSION,
        "org.junit.platform:junit-platform-reporting:%s" % JUNIT_VERSION,
    ] + _UNLEASH_ARTIFACTS,
    excluded_artifacts = [
        "asm:asm",
    ] + _V["excluded"],
    fail_if_repin_required = False,
    fetch_sources = True,
    generate_compat_repositories = True,
    repositories = [
        "https://repo1.maven.org/maven2",
    ],
    # Explicit pins above win over transitive versions, keeping Vert.x/ASM/Jandex/etc.
    # aligned with what QUARKUS_VERSION was tested against.
    version_conflict_policy = "pinned",
)

# Add deployment artifacts with exclusions for circular dependencies
maven.artifact(
    artifact = "quarkus-rest-deployment",
    exclusions = [
        "org.eclipse.sisu:org.eclipse.sisu.plexus",
        "org.apache.maven:maven-plugin-api",
        "org.apache.maven:maven-xml-impl",
        "org.codehaus.plexus:plexus-xml",
    ],
    group = "io.quarkus",
    version = QUARKUS_VERSION,
)
maven.artifact(
    artifact = "quarkus-vertx-http-deployment",
    exclusions = [
        "org.eclipse.sisu:org.eclipse.sisu.plexus",
        "org.apache.maven:maven-plugin-api",
        "org.apache.maven:maven-xml-impl",
        "org.codehaus.plexus:plexus-xml",
    ],
    group = "io.quarkus",
    version = QUARKUS_VERSION,
)

# ===========================================
# Tier 1: REST Jackson + Mutiny deployment
# ===========================================
maven.artifact(
    artifact = "quarkus-rest-jackson-deployment",
    exclusions = [
        "org.eclipse.sisu:org.eclipse.sisu.plexus",
        "org.apache.maven:maven-plugin-api",
        "org.apache.maven:maven-xml-impl",
        "org.codehaus.plexus:plexus-xml",
    ],
    group = "io.quarkus",
    version = QUARKUS_VERSION,
)
maven.artifact(
    artifact = "quarkus-mutiny-deployment",
    exclusions = [
        "org.eclipse.sisu:org.eclipse.sisu.plexus",
        "org.apache.maven:maven-plugin-api",
        "org.apache.maven:maven-xml-impl",
        "org.codehaus.plexus:plexus-xml",
    ],
    group = "io.quarkus",
    version = QUARKUS_VERSION,
)

# ===========================================
# Tier 2: Reactive DB Clients deployment
# ===========================================
maven.artifact(
    artifact = "quarkus-reactive-oracle-client-deployment",
    exclusions = [
        "org.eclipse.sisu:org.eclipse.sisu.plexus",
        "org.apache.maven:maven-plugin-api",
        "org.apache.maven:maven-xml-impl",
        "org.codehaus.plexus:plexus-xml",
    ],
    group = "io.quarkus",
    version = QUARKUS_VERSION,
)
maven.artifact(
    artifact = "quarkus-reactive-mysql-client-deployment",
    exclusions = [
        "org.eclipse.sisu:org.eclipse.sisu.plexus",
        "org.apache.maven:maven-plugin-api",
        "org.apache.maven:maven-xml-impl",
        "org.codehaus.plexus:plexus-xml",
    ],
    group = "io.quarkus",
    version = QUARKUS_VERSION,
)
maven.artifact(
    artifact = "quarkus-redis-client-deployment",
    exclusions = [
        "org.eclipse.sisu:org.eclipse.sisu.plexus",
        "org.apache.maven:maven-plugin-api",
        "org.apache.maven:maven-xml-impl",
        "org.codehaus.plexus:plexus-xml",
    ],
    group = "io.quarkus",
    version = QUARKUS_VERSION,
)

# ===========================================
# Tier 3: Messaging deployment
# ===========================================
maven.artifact(
    artifact = "quarkus-messaging-rabbitmq-deployment",
    exclusions = [
        "org.eclipse.sisu:org.eclipse.sisu.plexus",
        "org.apache.maven:maven-plugin-api",
        "org.apache.maven:maven-xml-impl",
        "org.codehaus.plexus:plexus-xml",
    ],
    group = "io.quarkus",
    version = QUARKUS_VERSION,
)
maven.artifact(
    artifact = "quarkus-messaging-kafka-deployment",
    exclusions = [
        "org.eclipse.sisu:org.eclipse.sisu.plexus",
        "org.apache.maven:maven-plugin-api",
        "org.apache.maven:maven-xml-impl",
        "org.codehaus.plexus:plexus-xml",
    ],
    group = "io.quarkus",
    version = QUARKUS_VERSION,
)
maven.artifact(
    artifact = "quarkus-grpc-deployment",
    exclusions = [
        "org.eclipse.sisu:org.eclipse.sisu.plexus",
        "org.apache.maven:maven-plugin-api",
        "org.apache.maven:maven-xml-impl",
        "org.codehaus.plexus:plexus-xml",
    ],
    group = "io.quarkus",
    version = QUARKUS_VERSION,
)

# ===========================================
# Tier 4: Observability deployment
# ===========================================
maven.artifact(
    artifact = "quarkus-micrometer-registry-prometheus-deployment",
    exclusions = [
        "org.eclipse.sisu:org.eclipse.sisu.plexus",
        "org.apache.maven:maven-plugin-api",
        "org.apache.maven:maven-xml-impl",
        "org.codehaus.plexus:plexus-xml",
    ],
    group = "io.quarkus",
    version = QUARKUS_VERSION,
)
maven.artifact(
    artifact = "quarkus-smallrye-health-deployment",
    exclusions = [
        "org.eclipse.sisu:org.eclipse.sisu.plexus",
        "org.apache.maven:maven-plugin-api",
        "org.apache.maven:maven-xml-impl",
        "org.codehaus.plexus:plexus-xml",
    ],
    group = "io.quarkus",
    version = QUARKUS_VERSION,
)

# ===========================================
# Tier 5: Quarkiverse deployment
# ===========================================
# Declared only on lines where Unleash is available (see _PROFILES).
[
    maven.artifact(
        artifact = "quarkus-unleash-deployment",
        exclusions = [
            "org.eclipse.sisu:org.eclipse.sisu.plexus",
            "org.apache.maven:maven-plugin-api",
            "org.apache.maven:maven-xml-impl",
            "org.codehaus.plexus:plexus-xml",
        ],
        group = "io.quarkiverse.unleash",
        version = v,
    )
    for v in ([UNLEASH_VERSION] if UNLEASH_VERSION else [])
]

maven.artifact(
    artifact = "quarkus-langchain4j-core-deployment",
    exclusions = [
        "org.eclipse.sisu:org.eclipse.sisu.plexus",
        "org.apache.maven:maven-plugin-api",
        "org.apache.maven:maven-xml-impl",
        "org.codehaus.plexus:plexus-xml",
    ],
    group = "io.quarkiverse.langchain4j",
    version = LANGCHAIN4J_VERSION,
)
maven.artifact(
    artifact = "quarkus-langchain4j-openai-deployment",
    exclusions = [
        "org.eclipse.sisu:org.eclipse.sisu.plexus",
        "org.apache.maven:maven-plugin-api",
        "org.apache.maven:maven-xml-impl",
        "org.codehaus.plexus:plexus-xml",
    ],
    group = "io.quarkiverse.langchain4j",
    version = LANGCHAIN4J_VERSION,
)
maven.artifact(
    artifact = "quarkus-langchain4j-ollama-deployment",
    exclusions = [
        "org.eclipse.sisu:org.eclipse.sisu.plexus",
        "org.apache.maven:maven-plugin-api",
        "org.apache.maven:maven-xml-impl",
        "org.codehaus.plexus:plexus-xml",
    ],
    group = "io.quarkiverse.langchain4j",
    version = LANGCHAIN4J_VERSION,
)
maven.artifact(
    artifact = "quarkus-tika-deployment",
    exclusions = [
        "org.eclipse.sisu:org.eclipse.sisu.plexus",
        "org.apache.maven:maven-plugin-api",
        "org.apache.maven:maven-xml-impl",
        "org.codehaus.plexus:plexus-xml",
    ],
    group = "io.quarkiverse.tika",
    version = TIKA_VERSION,
)
use_repo(maven, "maven")

# Line-dependent aliases for the examples (see examples/quarkus_line.bzl).
quarkus_line = use_repo_rule("//examples:quarkus_line.bzl", "quarkus_line")

quarkus_line(
    name = "quarkus_line",
    cdi_api = _V["cdi_api_label"],
    line = QUARKUS_LINE,
)
